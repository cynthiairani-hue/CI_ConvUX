# ─────────────────────────────────────────────────────────────────────────
# Cube Cloud — real data (LOCAL DEV ONLY)
#
# Copy this file to `.env.local` and fill in your values. `.env.local` is
# gitignored and is NOT deployed to Vercel, so the public demo stays on mock
# data. Do NOT add these vars to your Vercel project — that would expose your
# warehouse data on the public site.
#
# Without these vars, the app falls back to mock seed data everywhere.
# ─────────────────────────────────────────────────────────────────────────

# Your Cube Cloud deployment's REST API base (note the /cubejs-api/v1 suffix):
CUBE_API_URL=https://your-deployment.cubecloud.dev/cubejs-api/v1

# Cube API token (JWT). Generate from your deployment. KEEP SECRET — never commit.
CUBE_API_TOKEN=

# ── Map your semantic model ──────────────────────────────────────────────
# Set these to the measure/dimension names in YOUR Cube data model.
# Format is "<cube>.<member>". Defaults shown are placeholders.
CUBE_MEASURE_SPEND=marketing.spend
CUBE_MEASURE_REVENUE=marketing.revenue
CUBE_MEASURE_CONVERSIONS=marketing.conversions
# Optional — if your model has a CPA measure. Otherwise CPA is derived (spend/conversions).
# CUBE_MEASURE_CPA=marketing.cpa
CUBE_DIM_CHANNEL=marketing.channel
CUBE_TIME_DIMENSION=marketing.date
